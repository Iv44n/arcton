{
  "name": "arcton",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*",
    "examples/*"
  ],
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "bun lint --no-script --fix",
    "lint:check": "bun lint --no-script --max-warnings 0",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
