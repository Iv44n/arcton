{
  "name": "@arcton/adapter-node",
  "version": "0.0.5",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc --emitDeclarationOnly --declaration --noEmit false --rootDir src --outDir dist && bun build ./src/index.ts --target=node --outdir=dist --packages=external",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@arcton/contracts": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/ws": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
