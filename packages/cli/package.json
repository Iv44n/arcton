{
  "name": "arcton",
  "version": "0.0.7",
  "type": "module",
  "bin": {
    "arcton": "./dist/index.js"
  },
  "exports": {
    "./create": {
      "bun": "./src/commands/create.ts",
      "node": "./dist/commands/create.js",
      "default": "./dist/commands/create.js"
    }
  },
  "files": [
    "src",
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc --noEmit && bun build ./src/index.ts ./src/commands/create.ts --target=node --outdir=dist --packages=external",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@arcton/adapter-bun": "workspace:*",
    "@arcton/adapter-node": "workspace:*",
    "@arcton/contracts": "workspace:*",
    "@arcton/core": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "gradient-string": "^3.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/gradient-string": "^1.1.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
