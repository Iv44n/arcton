{
  "name": "@arcton/openapi",
  "version": "0.0.7",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc --emitDeclarationOnly --declaration --noEmit false --rootDir src --outDir dist && bun build ./src/index.ts --target=node --outdir=dist --packages=external",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@arcton/contracts": "workspace:*",
    "@scalar/client-side-rendering": "0.4.0"
  },
  "devDependencies": {
    "@arcton/core": "workspace:*",
    "@types/bun": "latest",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
