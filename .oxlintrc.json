{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "ignorePatterns": [
    ".agents/",
    ".claude/",
    "apps/",
    "packages/cli/template/",
    "**/*.test-d.ts",
    "**/dist/"
  ],
  "rules": {
    "typescript/no-empty-object-type": "off",
    "typescript/no-namespace": "off"
  }
}
